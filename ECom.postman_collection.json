{
  "info": {
    "_postman_id": "c39f4c51-9efa-4e91-9577-de1f12f2943c",
    "name": "ECom",
    "description": "E-Commerce API. Pagination, filtering, search and sorting on GetAll endpoints.\nBase URL: http://localhost:5090 (http launch profile from Properties/launchSettings.json).\nBoth controllers are rate-limited per client (EnableRateLimiting).\nVersioning: the version comes from the URL segment (/api/v1/...).\n\nPRICING: product responses expose realPrice (the original/base price) and priceAfterDiscount (the price after the currently active discount, or null when there is none). Add/Update still SEND 'Price' as the base price.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Category",
      "id": "5cf2556a-5e17-4507-9d9b-8bd2422d64b8",
