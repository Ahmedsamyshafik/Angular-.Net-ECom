              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"statusCode\": 200,\n  \"statusMessage\": \"Products found.\",\n  \"data\": {\n    \"pageNumber\": 1,\n    \"pageSize\": 10,\n    \"totalCount\": 2,\n    \"totalPages\": 1,\n    \"data\": [\n      {\n        \"id\": 36,\n        \"name\": \"Laptop Pro 15\",\n        \"realPrice\": 1000.00,\n        \"priceAfterDiscount\": 800.00,\n        \"categoryName\": \"Electronics\",\n        \"rowVersion\": \"AAAAAAAAB9E=\",\n        \"photoUrls\": [\n          {\n            \"id\": 10,\n            \"url\": \"imgs/product/14fe0b636d7c4e508382a4375310ad81.png\"\n          }\n        ]\n      },\n      {\n        \"id\": 37,\n        \"name\": \"Mouse\",\n        \"realPrice\": 250.00,\n        \"priceAfterDiscount\": null,\n        \"categoryName\": \"Electronics\",\n        \"rowVersion\": \"AAAAAAAAB9Q=\",\n        \"photoUrls\": []\n      }\n    ]\n  }\n}"
