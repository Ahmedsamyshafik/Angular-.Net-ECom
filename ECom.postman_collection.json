        {
          "id": "172ad8ec-7095-42b4-bd36-8fc051a03997",
          "name": "ApplyDiscount",
          "description": "Apply a discount to specific products.\nBody (JSON):\n- productIds: array of product ids (required)\n- from / to: the active window, both bounds inclusive\n- discountType: 1 = Percentage, 2 = FixedAmount\n- value: the percentage, or the fixed amount\n- name: optional label\nA product may carry several active discounts; the lowest resulting price is then reported as priceAfterDiscount.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
