        {
          "id": "ecbeacc2-b45b-47bd-8d12-b7ec7d34f0f3",
          "name": "AddProduct",
          "description": "Create a product. Form-data (multipart/form-data): Name, Description, Price (the ORIGINAL/base price), CategoryId, Files (image(s)). Optional discount fields (DiscountName, DiscountType, DiscountValue, DiscountFrom, DiscountTo) create the product already discounted.\nDiscountType: 1 = Percentage, 2 = FixedAmount.\nNOTE: the response returns realPrice plus priceAfterDiscount, which is null here because the discount is applied after the product is created.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "body": {
