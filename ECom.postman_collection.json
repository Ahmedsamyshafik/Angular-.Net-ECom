      "item": [
        {
          "id": "224b36e8-2dbc-4df2-980f-4227e8c3633c",
          "name": "GetAll",
          "description": "Paginated list of categories with optional search, hasProducts filter and sorting.\nQuery params (all optional):\n- pageNumber (default 1)\n- pageSize (default 10)\n- search (searches Name/Description; space-separated terms are ANDed)\n- hasProducts (true/false - only categories that have / have no products)\n- sortBy: id | name | createdAt (default id)\n- sortOrder: asc | desc (default asc)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5090/api/v1/Category/GetAll?pageNumber=1&pageSize=10&search=electronics&hasProducts=true&sortBy=name&sortOrder=asc",
              "protocol": "http",
"host": [
                  "localhost"
                ],
                "port": "5090",
              "path": [
                "api",
                "v1",
                "Category",
                "GetAll"
              ],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1",
                  "description": "Page number (min 1)"
                },
                {
                  "key": "pageSize",
                  "value": "10",
                  "description": "Page size (min 1)"
                },
                {
                  "key": "search",
                  "value": "electronics",
                  "description": "Search in Name/Description"
                },
                {
                  "key": "hasProducts",
                  "value": "true",
                  "description": "true = only categories that have products, false = only categories with none"
                },
                {
                  "key": "sortBy",
                  "value": "name",
                  "description": "id | name | createdAt"
                },
                {
                  "key": "sortOrder",
                  "value": "asc",
                  "description": "asc | desc"
                }
              ]
            }
          }
        },
